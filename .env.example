# ============================================================================
# Naija E-Invoice — Phase 0 environment
# Copy to .env and adjust as needed. Every variable below is required unless
# marked [optional] with its default.
# ============================================================================

# --- App ---
NODE_ENV=development
# Port the HTTP API listens on.
PORT=3000

# --- Database (Postgres 16, provisioned by docker compose) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://naija:naija@localhost:5432/naija_einvoice?schema=public
# Separate test database (created automatically by the docker init script).
# Used only by the integration tests.
DATABASE_URL_TEST=postgresql://naija:naija@localhost:5432/naija_einvoice_test?schema=public

# --- Queue (Redis 7, provisioned by docker compose) ---
REDIS_URL=redis://localhost:6379

# --- NRS submission (STUBBED in Phase 0 — no NRS accreditation yet) ---
# mock  -> MockNRSProvider: simulates 2-4s latency + configurable failure rate.
# real  -> RealNRSProvider: NOT implemented. Requires NRS MBS accreditation
#          (Phase 1). Selecting it throws at submit time.
NRS_PROVIDER=mock
# Simulated failure rate for the mock provider (0..1). 0.05 = 5% random failures.
MOCK_NRS_FAIL_RATE=0.05
# Simulated latency window for the mock provider, in milliseconds.
MOCK_NRS_DELAY_MS_MIN=2000
MOCK_NRS_DELAY_MS_MAX=4000

# --- WhatsApp Business Cloud API (STUBBED in Phase 0) ---
# Token used for the GET /webhooks/whatsapp verification handshake that the
# real Cloud API performs when you register the webhook. In Phase 0 it is only
# used by the CLI harness and the verification endpoint.
WHATSAPP_VERIFY_TOKEN=change-me-local-verify-token
