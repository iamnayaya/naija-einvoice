// ============================================================================
// Naija E-Invoice domain model (single source of truth for the database).
//
// Phase 0 note:
//   - `tin` is nullable: most micro-merchants are not yet NRS-registered.
//     Phase 1 adds a TIN-collection flow during onboarding.
//   - Money is stored as Decimal(12,2) — naira with kobo precision. Never
//     float. All JSON APIs carry money as decimal strings.
//   - `rawPayload` on Transaction stores EXACTLY what the source system
//     (WhatsApp Cloud API / POS) sent in, untouched, for audit/replay.
//   - `submissionError` captures the last NRS failure so retry/ops can see it
//     without joining against logs.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // Default output (node_modules/.prisma/client), re-exported by @prisma/client.
  // A custom `output` path makes `prisma generate` try to reinstall
  // @prisma/client in pnpm workspaces — avoid that friction.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PreferredLanguage {
  ha // Hausa
  yo // Yoruba
  ig // Igbo
  pcm // Nigerian Pidgin
  en // English
}

enum SubscriptionTier {
  free
  starter
  growth
}

enum TransactionSource {
  whatsapp
  pos
}

enum PosProvider {
  paystack
  moniepoint
  opay
}

enum InvoiceStatus {
  draft
  pending_submission
  submitted
  validated
  failed
  // Free tier's monthly invoice quota is exhausted. Not retried by the queue —
  // the merchant must upgrade (or the month rolls over) to resume invoicing.
  blocked_by_quota
}

enum SubscriptionStatus {
  // Paystack subscription created; first payment not yet captured.
  incomplete
  active
  // Cancelled / disabled on Paystack (subscription.disable webhook).
  disabled
}

enum ConversationPhase {
  awaiting_details
  awaiting_confirmation
  processing
  completed
}

model Merchant {
  id                 String            @id @default(cuid())
  businessName       String
  phone              String            @unique
  tin                String? // nullable until NRS registration (Phase 1)
  state              String
  preferredLanguage  PreferredLanguage @default(en)
  subscriptionTier   SubscriptionTier  @default(free)
  onboardedByAgentId String?
  onboardedByAgent   Agent?            @relation(fields: [onboardedByAgentId], references: [id], onDelete: SetNull)
  transactions       Transaction[]
  conversationStates ConversationState[]
  posTerminals       PosTerminal[]
  subscription       Subscription?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([onboardedByAgentId])
}

model Agent {
  id                   String     @id @default(cuid())
  name                 String
  phone                String     @unique
  momoAccountForPayout String // MoMo (MoMo Agent / MTN MoMo / OPay) account for revenue share
  revenueShareRate     Decimal    @default(0.05) @db.Decimal(5, 4) // e.g. 0.05 = 5%
  merchants            Merchant[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Transaction {
  id          String           @id @default(cuid())
  merchantId  String
  merchant    Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  amount      Decimal          @db.Decimal(12, 2)
  customerRef String? // optional buyer reference (phone, name, POS receipt no.)
  source      TransactionSource
  // For POS-originated sales: the provider's transaction reference
  // (Paystack `reference`, Moniepoint `transactionReference`, OPay `outOrderNo`).
  // Unique so a provider webhook retry can never double-create a Transaction.
  providerReference String?       @unique
  rawPayload  Json? // exact inbound payload from WhatsApp Cloud API / POS
  invoice     Invoice?
  createdAt   DateTime         @default(now())

  @@index([merchantId, createdAt])
  @@index([source, createdAt])
}

model PosTerminal {
  id          String      @id @default(cuid())
  provider    PosProvider
  // Provider's terminal identifier: Paystack virtual-terminal code (VT_...),
  // Moniepoint terminal serial, OPay device `sn`.
  terminalRef String
  merchantId  String
  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([provider, terminalRef])
  @@index([merchantId])
}

model Subscription {
  id                  String             @id @default(cuid())
  merchantId          String             @unique
  merchant            Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // The tier this subscription is paying for. Source of truth for the merchant
  // being billed; merchant.subscriptionTier mirrors the ACTIVE subscription's
  // tier and is what quota enforcement reads.
  tier                SubscriptionTier   @default(starter)
  status              SubscriptionStatus @default(incomplete)

  // Paystack identifiers (sandbox-tested in Phase 2; refined once credentials exist).
  paystackSubscriptionCode String?       @unique // SUB_...
  paystackCustomerCode     String?               // CUS_...
  paystackPlanCode         String?               // PLN_...

  // Current billing window.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextPaymentDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Invoice {
  id              String        @id @default(cuid())
  transactionId   String        @unique
  transaction     Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  invoiceNumber   String        @unique // stable across retries; NRS may dedupe on it
  status          InvoiceStatus @default(draft)
  irn             String? // NRS Invoice Registration Number (returned on validation)
  csid            String? // NRS Communication Session ID
  qrCodeUrl       String?
  xmlPayload      Json? // Phase 1: UBL 2.1 XML (Peppol BIS 3.0) payload sent to NRS
  submissionError String? // last failure reason from the submission provider
  submittedAt     DateTime?
  validatedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt]) // status reporting / dashboarding
  @@index([status, updatedAt]) // retry-scanning (failed invoices ready to re-run)
}

model ConversationState {
  id               String            @id @default(cuid())
  merchantId       String
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  whatsappThreadId String            @unique
  state            ConversationPhase @default(awaiting_details)
  // Phase 1: pending sales awaiting confirmation, the field being clarified,
  // etc. See packages/shared/src/conversation/types.ts (ConversationContext).
  context          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([merchantId, updatedAt])
}
